# An Outer Office app builder for Linux desktop and the web: every SDK it needs, the deps branch,
# and Flutter from a git repository at a tag, branch or hash. See containers/README.md.
#
# The defaults are what tools/sdk/sdk.lock names on main; check_lock.py compares them.

ARG BASE_IMAGE=ghcr.io/gmeligio/flutter-linux:3.47.9@sha256:ef1920d34d6c8c2cafcf120ecb578e2c736d14c14e59e0c8817f329fb64be53e
FROM ${BASE_IMAGE}

USER root
ENTRYPOINT []
CMD ["bash"]
WORKDIR /src

# A base image's own Flutter stays where it is, unused, and its settings stay out of this one's.
# A commit-only clone is enough for Flutter's version and needs far less than a full one.
# TAR_OPTIONS: Flutter's archives name owners a rootless engine's user namespace cannot map, and tar
# as root would fail trying to apply them.
ENV TAR_OPTIONS=--no-same-owner \
    RUSTUP_HOME=/opt/ai6/rust/rustup \
    CARGO_HOME=/opt/ai6/rust/cargo \
    FLUTTER_ROOT=/opt/ai6/flutter \
    PUB_CACHE=/opt/ai6/pub-cache \
    AI6_SDK_DEPS=/opt/ai6/deps \
    XDG_CONFIG_HOME=/opt/ai6/config \
    FLUTTER_WINDOWING=true \
    PATH=/opt/ai6/rust/cargo/bin:/opt/ai6/flutter/bin:/opt/ai6/flutter/bin/cache/dart-sdk/bin:${PATH}

RUN set -eu; \
    if command -v apt-get >/dev/null; then \
      apt-get update; \
      apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
        build-essential clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null; then \
      dnf install -y --setopt=install_weak_deps=False ca-certificates curl git-core unzip xz tar \
        which gcc gcc-c++ clang cmake ninja-build pkgconf-pkg-config gtk3-devel xz-devel \
        libstdc++-devel; \
      dnf clean all; \
    else \
      echo "BASE_IMAGE has neither apt-get nor dnf: add the packages in containers/README.md" >&2; \
      exit 1; \
    fi; \
    git config --system --add safe.directory /opt/ai6/flutter

# umask 0: another user, such as a CI runner's, can use and extend everything here.
ARG RUST_VERSION=1.99.1
ARG RUSTUP_VERSION=1.29.2
ARG RUSTUP_SHA256_X64=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
ARG RUSTUP_SHA256_ARM64=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697
RUN set -eu; umask 0; \
    case "$(uname -m)" in \
      x86_64) triple=x86_64-unknown-linux-gnu; sha=$RUSTUP_SHA256_X64 ;; \
      aarch64) triple=aarch64-unknown-linux-gnu; sha=$RUSTUP_SHA256_ARM64 ;; \
      *) echo "no rustup-init hash for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/ai6/config; \
    curl -fsSL --retry 3 -o /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$triple/rustup-init"; \
    echo "$sha  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    RUSTUP_INIT_SKIP_PATH_CHECK=yes /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "$RUST_VERSION" -c clippy -c rustfmt -t wasm32-unknown-unknown; \
    rm -f /tmp/rustup-init; \
    rustc --version

# deps' pub/ is the pub cache, and its cdn/ is what tool/cdn_files.dart fill --deps reads.
ARG DEPS_GIT_URL=https://github.com/jose-pr/ai6.git
ARG DEPS_REF=1428dd7fcfd96caf3a21c543aa7de7b8d8569848
RUN set -eu; umask 0; \
    git init -q /tmp/deps; \
    git -C /tmp/deps fetch -q --depth 1 "$DEPS_GIT_URL" "$DEPS_REF" || { \
      echo "DEPS_REF $DEPS_REF is not in $DEPS_GIT_URL" >&2; exit 1; }; \
    git -C /tmp/deps checkout -q --detach FETCH_HEAD; \
    test -d /tmp/deps/pub/hosted; \
    test -d /tmp/deps/cdn; \
    mv /tmp/deps/pub "$PUB_CACHE"; \
    mkdir -p "$AI6_SDK_DEPS"; \
    mv /tmp/deps/cdn "$AI6_SDK_DEPS/cdn"; \
    rm -rf /tmp/deps

# Last, so another ref reuses every layer above it. Flutter refuses to run without its .git.
ARG FLUTTER_GIT_URL=https://github.com/flutter/flutter.git
ARG FLUTTER_REF=2541e508405f5d9728286d6ed3307163a5406e08
ENV FLUTTER_GIT_URL=${FLUTTER_GIT_URL}
LABEL ai6.flutter.git-url="${FLUTTER_GIT_URL}" ai6.flutter.ref="${FLUTTER_REF}"
RUN set -eu; umask 0; \
    git clone -q --filter=tree:0 --no-checkout "$FLUTTER_GIT_URL" "$FLUTTER_ROOT"; \
    cd "$FLUTTER_ROOT"; \
    resolve() { \
      git rev-parse -q --verify "refs/remotes/origin/$1^{commit}" 2>/dev/null \
        || git rev-parse -q --verify "refs/tags/$1^{commit}" 2>/dev/null \
        || git rev-parse -q --verify "$1^{commit}" 2>/dev/null; \
    }; \
    commit=$(resolve "$FLUTTER_REF") || { \
      git fetch -q origin "$FLUTTER_REF" 2>/dev/null && commit=$(git rev-parse -q --verify "FETCH_HEAD^{commit}"); \
    } || { \
      echo "FLUTTER_REF $FLUTTER_REF is not a tag, branch or commit of $FLUTTER_GIT_URL" >&2; exit 1; \
    }; \
    git checkout -q --detach "$commit"; \
    flutter config --no-analytics --no-cli-animations --enable-linux-desktop --enable-web \
      --enable-windowing; \
    flutter precache --linux --web; \
    flutter --version; \
    echo "$commit" > /opt/ai6/flutter-commit; \
    echo "ai6: FLUTTER_REF $FLUTTER_REF is commit $commit"

{
 "stand_ins": {
  "password": "valid for alice with the secret pw; the stand-in provider ldap rejects every password, local accepts alice/pw",
  "certificate": "valid when name is alice or bob, naming that person",
  "totp": "valid for the secret 123456 when name is the id of the person already named",
  "people": {
   "alice": {
    "id": "id-alice",
    "name": "alice",
    "groups": [
     "admins"
    ],
    "attributes": {}
   },
   "bob": {
    "id": "id-bob",
    "name": "bob",
    "groups": [],
    "attributes": {}
   }
  },
  "recovery_code": "valid once for the secret RECOVER-1 when name is the id of the person already named",
  "counting": "the stand-in consumer counts failed second-factor attempts per person id and, after 3, answers failed without asking the authenticator; a right second factor resets the count",
  "passkey": "valid when name is alice or bob, naming that person; the challenge a consumer keeps and the signed answer are the passkey provider's, a stand-in takes the name"
 },
 "flows": [
  {
   "name": "the offer for the page is the policy answer with nothing done",
   "point": 1,
   "config": {
    "rule": [
     {
      "networks": [
       "10.0.0.0/8"
      ],
      "allow": [
       [
        "password"
       ],
       [
        "certificate"
       ]
      ]
     },
     {
      "allow": [
       [
        "certificate"
       ]
      ]
     }
    ]
   },
   "steps": [
    {
     "action": "offer",
     "address": "10.1.2.3",
     "expect": {
      "result": "methods",
      "methods": [
       "password",
       "certificate"
      ],
      "authenticator_calls": 0,
      "throttled": false
     }
    },
    {
     "action": "offer",
     "address": "203.0.113.7",
     "expect": {
      "result": "methods",
      "methods": [
       "certificate"
      ],
      "authenticator_calls": 0,
      "throttled": false
     }
    },
    {
     "action": "offer",
     "expect": {
      "result": "methods",
      "methods": [
       "certificate"
      ],
      "authenticator_calls": 0,
      "throttled": false
     }
    }
   ]
  },
  {
   "name": "a method not offered from here is refused, asks nobody and counts nowhere",
   "point": 2,
   "config": {
    "rule": [
     {
      "networks": [
       "10.0.0.0/8"
      ],
      "allow": [
       [
        "password"
       ],
       [
        "certificate"
       ]
      ]
     },
     {
      "allow": [
       [
        "certificate"
       ]
      ]
     }
    ]
   },
   "steps": [
    {
     "action": "present",
     "address": "203.0.113.7",
     "method": "password",
     "name": "alice",
     "secret": "pw",
     "expect": {
      "result": "refused_unasked",
      "authenticator_calls": 0,
      "throttled": false
     }
    },
    {
     "action": "present",
     "address": "203.0.113.7",
     "method": "password",

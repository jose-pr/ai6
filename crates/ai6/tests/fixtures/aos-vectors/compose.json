    {
      "id": "default-paths-across-overlays",
      "description": "Each overlay's bin/ and lib/python/ are prepended in composition order, so the higher priority is found first; declaring another directory keeps them; [defaults] turns them off.",
      "overlays": {
        "low": {
          "priority": 100
        },
        "high": {
          "priority": 900
        },
        "manpages": {
          "priority": 500,
          "paths": [
            {
              "variable": "MANPATH",
              "path": "man"
            }
          ]
        },
        "quiet": {
          "priority": 600,
          "defaults": {
            "bin": false,
            "lib": false
          }
        }
      },
      "requested": [
        "high",
        "low",
        "manpages",
        "quiet"
      ],
      "files": {
        "low": [
          "bin/a",
          "lib/python/low.py"
        ],
        "high": [
          "bin/b",
          "lib/python/pkg/__init__.py"
        ],
        "manpages": [
          "bin/c",
          "lib/plain.py",
          "man/c.1"
        ],
        "quiet": [
          "bin/d",
          "lib/python/q.py"
        ]
      },
      "facts": {
        "os": "linux",
        "base_env": {
          "PATH": "/usr/bin:/bin"
        },
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high",
          "manpages": "/ov/manpages",
          "quiet": "/ov/quiet"
        }
      },
      "expect": {
        "active": [
          "low",
          "manpages",
          "quiet",
          "high"
        ],
        "env": {
          "PATH": "/ov/high/bin:/ov/manpages/bin:/ov/low/bin:/usr/bin:/bin",
          "LOW_OVERLAY_ROOT": "/ov/low",
          "MANPAGES_OVERLAY_ROOT": "/ov/manpages",
          "QUIET_OVERLAY_ROOT": "/ov/quiet",
          "HIGH_OVERLAY_ROOT": "/ov/high",
          "PYTHONPATH": "/ov/high/lib/python:/ov/low/lib/python",
          "MANPATH": "/ov/manpages/man"
        }
      }
    },
    {
      "id": "chain-across-overlays",

    {
      "id": "env-across-overlays",
      "description": "Root variables first; then each overlay's env and paths in order: the later overlay wins and its prepends come first.",
      "overlays": {
        "low": {
          "priority": 100,
          "env": {
            "MODE": "low",
            "ONLY_LOW": "1"
          },
          "paths": [
            {
              "variable": "PATH",
              "path": "bin"
            }
          ]
        },
        "high": {
          "priority": 900,
          "env": {
            "MODE": "high",
            "LOW_ROOT_SEEN": {
              "value": "x",
              "if_unset": true
            }
          },
          "paths": [
            {
              "variable": "PATH",
              "path": "bin"
            },
            {
              "variable": "PATH",
              "path": "tools",
              "position": "append"
            }
          ]
        }
      },
      "requested": [
        "high",
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {
          "PATH": "/usr/bin:/bin"
        },
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high"
        }
      },
      "expect": {
        "active": [
          "low",
          "high"
        ],
        "env": {
          "PATH": "/ov/high/bin:/ov/low/bin:/usr/bin:/bin:/ov/high/tools",
          "LOW_OVERLAY_ROOT": "/ov/low",
          "HIGH_OVERLAY_ROOT": "/ov/high",
          "MODE": "high",
          "ONLY_LOW": "1",
          "LOW_ROOT_SEEN": "x"
        }
      }
    },

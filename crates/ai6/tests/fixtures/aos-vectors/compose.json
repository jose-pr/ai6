          "env": "TOOL_HOME=${AOS_OVERLAY_ROOT}/tool\nTOOL_CONF=${TOOL_HOME}/conf\n"
        },
        "high": {}
      },
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high"
        }

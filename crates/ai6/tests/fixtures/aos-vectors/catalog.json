    {
      "id": "git-base",
      "description": "A catalog in a Git repository: a relative source is the same repository at the same ref; refs, pins, and what a remote catalog may not name.",
      "catalog": {
        "name": "overlays.toml",
        "text": "[overlays]\nrust = \"../overlays/rust\"\ndocs = \"./docs#guides\"\nwhole = \"..\"\noutside = \"../../outside\"\nlocal-dir = \"/srv/overlays/x\"\nlocal-drive = 'C:\\overlays\\x'\nlocal-git = \"file:///srv/agents.git\"\nlocal-git-path = \"/srv/agents.git\"\nscp = \"git@github.com:example/other.git@v1#net\"\nweb = \"https://example.org/overlays/web\"\n\n[overlays.pinned]\nsource = \"https://github.com/example/tools.git#lint\"\nref = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\npin = \"sha256:ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB\"\n\n[overlays.twice]\nsource = \"https://github.com/example/tools.git@v1#lint\"\nref = \"v2\"\n\n[overlays.relative-ref]\nsource = \"./docs\"\nref = \"v3\"\n\n[overlays.url-ref]\nsource = \"https://example.org/overlays/web\"\nref = \"v1\"\n\n[overlays.ref-slash]\nsource = \"https://github.com/example/tools.git\"\nref = \"release/1.0\"\n",
        "base": "https://github.com/example/agents.git@v2#catalogs/overlays.toml"
      },
      "expect": {
        "form": "full",
        "entries": {
          "docs": {
            "source": {
              "kind": "git",
              "location": "https://github.com/example/agents.git",
              "ref": "v2",
              "path": "catalogs/docs/guides"
            }
          },
          "pinned": {
            "source": {
              "kind": "git",
              "location": "https://github.com/example/tools.git",
              "ref": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
              "path": "lint"
            },
            "pin": "sha256:ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB"
          },
          "rust": {
            "source": {
              "kind": "git",
              "location": "https://github.com/example/agents.git",
              "ref": "v2",
              "path": "overlays/rust"
            }
          },
          "scp": {
            "source": {
              "kind": "git",
              "location": "git@github.com:example/other.git",
              "ref": "v1",
              "path": "net"
            }
          },
          "web": {
            "source": {
              "kind": "url",
              "location": "https://example.org/overlays/web",
              "ref": null,
              "path": null
            }
          },
          "whole": {
            "source": {
              "kind": "git",
              "location": "https://github.com/example/agents.git",
              "ref": "v2",
              "path": null
            }
          }
        },
        "refused": [
          [
            "local-dir",
            "local-source"
          ],
          [
            "local-drive",
            "local-source"
          ],
          [
            "local-git",
            "local-source"
          ],
          [
            "local-git-path",
            "local-source"
          ],
          [
            "outside",
            "leaves-repository"
          ],
          [
            "ref-slash",
            "invalid-entry"
          ],
          [
            "relative-ref",
            "ref-not-allowed"
          ],
          [
            "twice",
            "ref-not-allowed"
          ],
          [
            "url-ref",
            "ref-not-allowed"
          ]
        ],
        "ignored": []
      }
    },

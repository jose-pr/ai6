        "name": "catalog.toml",
        "text": "x_store = \"anything\"\n\n[overlays.a]\nsource = \"../a\"\npinn = \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n\n[overlays.b]\nsource = \"../b\"\nabout = { summary = \"B\", stars = 5 }\n",
        "base": "/srv/overlays/catalogs/catalog.toml"

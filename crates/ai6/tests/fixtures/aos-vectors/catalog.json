        "name": "catalog.toml",
        "text": "[overlays]\nnumber = 5\nblank = \"   \"\noption = \"-oProxyCommand=x.git\"\ngood = \"../good\"\n\n[overlays.no-source]\ndescription = \"Nothing to fetch.\"\n\n[overlays.bad-pin]\nsource = \"../x\"\npin = \"sha1:0123456789abcdef0123456789abcdef01234567\"\n\n[overlays.source-list]\nsource = [\"../x\"]\n",
        "base": "/srv/overlays/catalogs/catalog.toml"
      },
      "expect": {
        "form": "full",
        "entries": {
          "good": {
            "source": {
              "kind": "directory",
              "location": "/srv/overlays/good",
              "ref": null,
              "path": null
            }
          }
        },
        "refused": [
          [
            "bad-pin",
            "invalid-pin"
          ],
          [
            "blank",
            "invalid-source"
          ],
          [
            "no-source",
            "invalid-entry"
          ],
          [
            "number",
            "invalid-entry"
          ],
          [
            "option",
            "invalid-source"
          ],
          [
            "source-list",
            "invalid-entry"
          ]
        ],
        "ignored": []
      }
    },
    {

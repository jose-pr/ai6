    {
      "id": "full-example",
      "description": "The full form: three entries with icons, one pinned.",
      "catalog": {
        "name": "catalog.toml",
        "text": "# A catalog in the full form: the registry format, with informational fields a store lists and\n# searches before it fetches anything. registry.json, registry.toml and registry.yaml are catalogs\n# in the minimal form. Relative sources and icons resolve beside this file.\nname = \"Example overlays\"\ndescription = \"The overlays of the AOS examples, listed for a store.\"\nhomepage = \"https://example.org/overlays\"\n\n# A string entry is the minimal form, a table the full form; one catalog may mix them.\n[overlays.engineering]\nsource = \"../engineering\"\ndescription = \"Shared engineering practices and review guidance.\"\n\n[overlays.engineering.about]\nsummary = \"Repository-wide engineering practices.\"\nicon = \"icons/engineering.png\"\ntags = [\"engineering\", \"review\"]\n\n[overlays.python-review]\nsource = \"../dependent\"\n\n[overlays.python-review.about]\nsummary = \"Python review guidance, on top of engineering.\"\nicon = \"icons/python-review.png\"\nlicense = \"MIT\"\ntags = [\"python\", \"review\"]\n\n[overlays.release-notes]\nsource = \"../about\"\npin = \"sha256:8280aaf5de7c4f61342f648586d534e481ae095cef223dded70f5b1db5bd84a1\"\n\n[overlays.release-notes.about]\nsummary = \"Release notes and changelogs, written the same way in every repository.\"\nicon = \"icons/release-notes.png\"\nhomepage = \"https://example.org/overlays/release-notes\"\nrepository = \"https://github.com/example/overlays\"\nlicense = \"MIT OR Apache-2.0\"\nauthors = [\"Example Docs Team <docs@example.org>\"]\ntags = [\"documentation\", \"release\", \"changelog\"]\n",
        "base": "/srv/overlays/registry/catalog.toml"
      },
      "expect": {
        "form": "full",
        "name": "Example overlays",
        "description": "The overlays of the AOS examples, listed for a store.",
        "homepage": "https://example.org/overlays",
        "entries": {
          "engineering": {
            "source": {
              "kind": "directory",
              "location": "/srv/overlays/engineering",
              "ref": null,
              "path": null
            },
            "description": "Shared engineering practices and review guidance.",
            "about": {
              "summary": "Repository-wide engineering practices.",
              "icon": "icons/engineering.png",
              "tags": [
                "engineering",
                "review"
              ]
            }
          },
          "python-review": {
            "source": {
              "kind": "directory",
              "location": "/srv/overlays/dependent",
              "ref": null,
              "path": null
            },
            "about": {
              "summary": "Python review guidance, on top of engineering.",
              "icon": "icons/python-review.png",
              "license": "MIT",
              "tags": [
                "python",
                "review"
              ]
            }
          },
          "release-notes": {
            "source": {
              "kind": "directory",
              "location": "/srv/overlays/about",
              "ref": null,
              "path": null
            },
            "pin": "sha256:8280aaf5de7c4f61342f648586d534e481ae095cef223dded70f5b1db5bd84a1",
            "about": {
              "summary": "Release notes and changelogs, written the same way in every repository.",
              "icon": "icons/release-notes.png",
              "homepage": "https://example.org/overlays/release-notes",
              "repository": "https://github.com/example/overlays",
              "license": "MIT OR Apache-2.0",
              "authors": [
                "Example Docs Team <docs@example.org>"
              ],
              "tags": [
                "documentation",
                "release",
                "changelog"
              ]
            }
          }
        },
        "refused": [],
        "ignored": []
      }
    },

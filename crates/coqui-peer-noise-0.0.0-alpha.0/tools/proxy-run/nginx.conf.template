# A reverse proxy ending TLS and passing WebSocket to a relay: the deployment PROTOCOL.md describes, with
# nothing tuned for this method. @WORK@, @PORT@ and @RELAY@ are filled in by serve.sh.
daemon off;
pid @WORK@/nginx.pid;
error_log @WORK@/error.log info;

events {
    worker_connections 64;
}

http {
    client_body_temp_path @WORK@/client;
    proxy_temp_path @WORK@/proxy;
    fastcgi_temp_path @WORK@/fastcgi;
    uwsgi_temp_path @WORK@/uwsgi;
    scgi_temp_path @WORK@/scgi;

    log_format proxied '$status $ssl_protocol $ssl_cipher $upstream_addr $uri bytes=$bytes_sent';
    access_log @WORK@/access.log proxied;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 127.0.0.1:@PORT@ ssl;
        server_name localhost;
        ssl_certificate @WORK@/cert.pem;
        ssl_certificate_key @WORK@/key.pem;

        location /relay/ {
            proxy_pass http://127.0.0.1:@RELAY@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # The same, with a read timeout short enough to see the proxy itself end a connection.
        location /idle/ {
            proxy_pass http://127.0.0.1:@RELAY@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout @IDLE@s;
        }

        location / {
            proxy_pass http://127.0.0.1:@RELAY@;
            proxy_read_timeout 300s;
        }
    }
}
